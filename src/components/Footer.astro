---
import ImgLogo from "@/assets/logo-byticode-without-bg-po.webp";

const year = new Date().getFullYear();

const sections = [
  { label: 'Servicios', href: '#services' },
  { label: 'Proyectos', href: '#work' },
  { label: 'Proceso',   href: '#process' },
  { label: 'Precios',   href: '#pricing' },
  { label: 'Nosotros',  href: '#about' },
  { label: 'FAQs',      href: '#faqs' },
];

const services = [
  { label: 'Web & Apps', href: '#services' },
  { label: 'Branding & Design', href: '#services' },
  { label: 'Consultoría', href: '#services' },
];

const contact = [
  { label: 'hola@byticode.com', href: 'mailto:hola@byticode.com' },
  { label: 'LinkedIn', href: 'https://linkedin.com' },
  { label: 'GitHub', href: 'https://github.com' },
  { label: 'Instagram', href: 'https://instagram.com' },
];

const columns = [
  { title: 'Secciones', links: sections },
  { title: 'Servicios', links: services },
  { title: 'Contacto', links: contact },
];
---

<footer class="mt-[90px] border-t border-white/[0.07]">
  <div class="mx-auto grid max-w-[1280px] grid-cols-[1.6fr_1fr_1fr_1fr] gap-10 px-10 pt-[60px] pb-10 max-[900px]:grid-cols-2 max-[900px]:px-6 max-[580px]:grid-cols-1 max-[580px]:px-5">
    <div data-reveal="soft">
      <a href="/" class="mb-[18px] flex items-center gap-[11px] text-[18px] font-medium text-white no-underline" aria-label="Byticode Home">
        <img src={ImgLogo.src} alt="" class="h-6 w-6 object-contain invert" />
        byticode
      </a>
      <p class="m-0 max-w-[290px] text-[14.5px] font-light leading-[1.6] text-[#8b8b92]">
        Tu socio de desarrollo de software. Diseñamos y construimos productos digitales — más rápido y más inteligente.
      </p>
    </div>

    {columns.map((col, ci) => (
      <div data-reveal="soft" style={`--rd:${(ci + 1) * 60}ms`}>
        <div class="mb-[18px] text-[12px] uppercase tracking-[0.06em] text-[#6f6f77]">
          {col.title}
        </div>
        <ul class="m-0 flex list-none flex-col gap-3 p-0">
          {col.links.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-[14.5px] font-light text-[#b3b3ba] no-underline transition-colors duration-200 hover:text-white"
                {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-5 border-t border-white/[0.06] px-10 pt-6 pb-10 max-[900px]:px-6 max-[580px]:px-5">
    <span class="text-[13px] font-light text-[#6f6f77]">&copy; {year} byticode. Todos los derechos reservados.</span>
    <span class="text-[13px] font-light text-[#6f6f77]">Hecho con código &amp; café</span>
  </div>
</footer>
