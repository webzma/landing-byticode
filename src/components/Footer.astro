---
const year = new Date().getFullYear();

const links = [
  { label: 'Servicios', href: '#services' },
  { label: 'Proyectos', href: '#work' },
  { label: 'Proceso',   href: '#process' },
  { label: 'Nosotros',  href: '#about' },
  { label: 'FAQs',      href: '#faqs' },
  { label: 'Contacto',  href: '#contact' },
];

const socials = [
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com',
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
  {
    label: 'GitHub',
    href: 'https://github.com',
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  },
  {
    label: 'Instagram',
    href: 'https://instagram.com',
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    label: 'X / Twitter',
    href: 'https://x.com',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
];
---

<footer class="bg-black border-t border-white/8 py-16 px-6 max-[580px]:px-5">
  <div class="max-w-[1080px] mx-auto">

    <!-- Brand block on the left, navigation as its own labelled column -->
    <div class="grid grid-cols-[1fr_auto] gap-16 mb-14 max-[700px]:grid-cols-1 max-[700px]:gap-10 max-[700px]:mb-10">

      <div data-reveal="soft">
        <a href="/" class="text-[1.0625rem] font-extrabold tracking-[-0.03em] text-white no-underline hover:opacity-80 transition-opacity duration-300 ease-soft" aria-label="Byticode Home">
          Byticode
        </a>
        <div class="flex items-center gap-2 mt-6">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="w-8 h-8 rounded-lg bg-white/4 border border-white/8 flex items-center justify-center text-white/35 hover:text-white/75 hover:bg-white/8 hover:border-white/15 transition-[color,background-color,border-color] duration-300 ease-soft"
              set:html={s.icon}
            />
          ))}
        </div>
      </div>

      <nav class="min-w-[180px]" aria-label="Footer navigation" data-reveal="soft" data-reveal-delay="1">
        <p class="m-0 mb-5 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-white/40">
          Navegación
        </p>
        <ul class="m-0 flex list-none flex-col gap-3 p-0">
          {links.map((l) => (
            <li>
              <a href={l.href} class="text-[0.875rem] text-white/40 hover:text-white no-underline transition-colors duration-300 ease-soft">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

    </div>

    <div class="pt-6 border-t border-white/6" data-reveal="fade" data-reveal-delay="2">
      <p class="text-[0.8125rem] text-white/25 m-0">
        &copy; {year} Byticode. Todos los derechos reservados.
      </p>
    </div>

  </div>
</footer>
