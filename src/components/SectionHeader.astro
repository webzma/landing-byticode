---
/**
 * El abridor de sección repetido: tag pill, titular light, línea de apoyo —
 * apilados y centrados, tal como la referencia. El bloque entero sube como
 * un solo reveal (la referencia anima el header como un único objetivo).
 */
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  headingId?: string;
  /** Constrains the headline measure. */
  titleWidth?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  headingId,
  titleWidth,
  class: className = "",
} = Astro.props as Props;
---

<div class:list={["section-head", className]} data-reveal>
  <span class="tag">{eyebrow}</span>
  <h2
    id={headingId}
    class="section-title"
    style={titleWidth ? `max-width:${titleWidth}` : undefined}>
    {title}
  </h2>
  {description && <p class="section-sub">{description}</p>}
</div>
