---
import SectionHeader from './SectionHeader.astro';

const testimonials = [
  {
    quote: "Byticode transformó nuestra presencia digital. El sitio web que desarrollaron superó todas nuestras expectativas en velocidad y diseño.",
    name: "Carlos M.",
    role: "CEO",
    company: "Nexara Studio",
    initials: "CM",
  },
  {
    quote: "El proceso fue claro y eficiente. Desde el diseño hasta el lanzamiento, siempre estuvieron disponibles y entregaron a tiempo.",
    name: "Andrea L.",
    role: "Product Manager",
    company: "FlowSync",
    initials: "AL",
  },
  {
    quote: "Nuestro rediseño de UX incrementó la retención de usuarios notablemente. Recomendaría Byticode a cualquier startup que busque crecer.",
    name: "Mateo R.",
    role: "Founder",
    company: "Prismacore",
    initials: "MR",
  },
];
---

<section id="testimonials" class="relative overflow-hidden pt-[130px] max-[900px]:pt-[100px] max-[640px]:pt-[84px]">
  <div class="mx-auto max-w-[1200px] px-10 max-[900px]:px-6 max-[640px]:px-5">
    <SectionHeader
      eyebrow="Testimonios"
      title="Lo que dicen nuestros clientes"
      description="Proyectos reales, resultados reales."
    />
  </div>

  <!-- Marquee infinito con máscara de bordes, como la referencia. Cuatro
       copias para que cada mitad del track supere el viewport más ancho. -->
  <div class="marquee-mask overflow-hidden" data-reveal>
    <div
      class="marquee-track flex gap-5"
      data-marquee
      data-marquee-duration="44">
      {[...testimonials, ...testimonials, ...testimonials, ...testimonials].map((t) => (
        <article class="w-[380px] max-w-[84vw] shrink-0 rounded-[18px] border border-white/[0.07] bg-[#0d0d10] p-7">
          <p class="m-0 mb-[22px] text-[15px] font-light leading-[1.65] text-[#d4d4da]">
            "{t.quote}"
          </p>
          <div class="flex items-center gap-3">
            <div
              class="flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full text-[13px] font-medium"
              style="background: var(--icon-box-bg); border: 1px solid var(--icon-box-border); color: var(--accent-soft)"
              aria-hidden="true">
              {t.initials}
            </div>
            <div>
              <div class="text-[14.5px] font-medium text-[#f1f1f4]">{t.name}</div>
              <div class="text-[13px] font-light text-[#8b8b92]">{t.role} · {t.company}</div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-track {
    width: max-content;
  }
</style>
