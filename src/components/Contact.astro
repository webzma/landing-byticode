---
import ImgLogo from "@/assets/logo-byticode-without-bg-po.webp";
---

<section id="contact" class="section section--narrow">
  <!-- El panel de cierre: la misma losa con glow inferior que la referencia -->
  <div class="cta-panel" data-reveal="zoom">
    <div class="cta-glow" aria-hidden="true"></div>

    <div class="relative">
      <img
        src={ImgLogo.src}
        alt=""
        class="mx-auto mb-[26px] block h-10 w-10 object-contain invert"
      />
      <h2
        id="contact-heading"
        class="mx-auto mb-[18px] max-w-[660px] text-[clamp(32px,4.4vw,60px)] font-light leading-[1.05] tracking-[-0.02em] text-balance text-[#f4f4f7]">
        Hablemos de tu proyecto
      </h2>
      <p class="mx-auto mb-9 max-w-[520px] text-[18px] font-light leading-[1.6] text-[#9a9aa1]">
        Cuéntanos tu idea y te responderemos en menos de 24 horas — sin compromiso.
      </p>

      <div class="flex flex-wrap justify-center gap-3.5 max-[580px]:flex-col max-[580px]:items-stretch">
        <a href="mailto:hola@byticode.com" class="btn-primary">
          Enviar email
          <span class="text-[16px]" aria-hidden="true">&#8594;</span>
        </a>
        <a
          href="https://wa.me/1234567890"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
        <a
          href="https://calendly.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost">
          Reservar llamada
        </a>
      </div>

      <p class="m-0 mt-8 text-[14px] font-light text-[#6f6f77]">
        o escríbenos a
        <a href="mailto:hola@byticode.com" class="text-[#b3b3ba] underline underline-offset-2 transition-colors duration-300 hover:text-white">
          hola@byticode.com
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--surface-2);
    padding: 96px 40px 110px;
    text-align: center;
  }
  .cta-glow {
    position: absolute;
    bottom: -160px;
    left: 50%;
    width: 900px;
    max-width: 120%;
    height: 520px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse 50% 60% at 50% 60%,
      rgba(47, 107, 255, 0.42),
      rgba(106, 59, 255, 0.22) 36%,
      rgba(31, 170, 201, 0.1) 54%,
      transparent 72%
    );
    filter: blur(36px);
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .cta-panel {
      padding: 64px 22px 76px;
    }
  }
</style>
