---
---

<section id="contact" class="relative bg-background py-28 px-6 overflow-hidden max-[900px]:py-20 max-[640px]:py-16 max-[640px]:px-5">
  <div class="absolute w-[700px] h-[600px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none blur-[24px]" aria-hidden="true" style="background: radial-gradient(ellipse, var(--glow-sm) 0%, transparent 68%)"></div>

  <div class="relative z-10 max-w-[1080px] mx-auto">
    <!-- The closing panel: same slab language as the hero, bookending the page -->
    <div
      class="mx-auto rounded-[24px] border border-hairline bg-white/[0.03] px-10 py-20 backdrop-blur-sm max-[640px]:px-6 max-[640px]:py-14"
      data-reveal="zoom">
      <div class="max-w-[640px] mx-auto text-center">

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 border border-white/15 rounded-full bg-white/4 text-[0.8125rem] text-white/60 mb-8" data-reveal="soft">
        <span class="w-[6px] h-[6px] rounded-full shrink-0 animate-pulse-dot" aria-hidden="true" style="background: var(--status-online)"></span>
        Aceptando nuevos proyectos
      </div>

      <h2 id="contact-heading" class="font-sans text-[clamp(2.25rem,5vw,4rem)] font-extrabold leading-[1.07] tracking-[-0.04em] text-white mb-6" data-split>
        Hablemos de<br>tu proyecto
      </h2>
      <p class="text-[clamp(0.9375rem,1.4vw,1.0625rem)] leading-[1.65] text-white/55 mb-12 max-w-[420px] mx-auto" data-reveal data-reveal-delay="2">
        Cuéntanos tu idea y te responderemos en menos de 24 horas.
      </p>

      <div class="flex flex-wrap gap-4 justify-center max-[580px]:flex-col max-[580px]:items-center" data-reveal data-reveal-delay="3">
        <a
          href="mailto:hola@byticode.com"
          class="inline-flex items-center gap-2 py-3.5 px-8 bg-white text-black no-underline text-[0.9375rem] font-semibold rounded transition-all duration-200 hover:opacity-90 hover:-translate-y-px max-[580px]:w-full max-[580px]:max-w-[280px] max-[580px]:justify-center"
        >
          Enviar email
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
            <path d="M2.5 7.5h10M8.5 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="https://wa.me/1234567890"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 py-3.5 px-8 bg-white/6 border border-white/15 text-white no-underline text-[0.9375rem] font-semibold rounded transition-all duration-200 hover:bg-white/10 hover:border-white/25 max-[580px]:w-full max-[580px]:max-w-[280px] max-[580px]:justify-center"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
        <a
          href="https://calendly.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 py-3.5 px-8 bg-white/6 border border-white/15 text-white no-underline text-[0.9375rem] font-semibold rounded transition-all duration-200 hover:bg-white/10 hover:border-white/25 max-[580px]:w-full max-[580px]:max-w-[280px] max-[580px]:justify-center"
        >
          Reservar llamada
        </a>
      </div>

      <p class="text-[0.875rem] text-white/35 mt-8 m-0" data-reveal="soft" data-reveal-delay="4">
        o escríbenos a
        <a href="mailto:hola@byticode.com" class="text-white/60 hover:text-white transition-colors duration-300 ease-soft underline underline-offset-2">
          hola@byticode.com
        </a>
      </p>

      </div>
    </div>
  </div>
</section>
