---
import SectionHeader from './SectionHeader.astro';
import SupabaseIcon from '../assets/icons/supabase.astro';
import ReactIcon from "../assets/icons/react.astro"
import NextIcon from "../assets/icons/next.astro"
import TypescriptIcon from "../assets/icons/typescript.astro"
import AstroaIcon from '@/assets/icons/astroa.astro';
import TailwindIcon from '@/assets/icons/tailwind.astro';
import FastapiIcon from '@/assets/icons/fastapi.astro';
import LaravelIcon from '@/assets/icons/laravel.astro';
import MysqlIcon from '@/assets/icons/mysql.astro';
import PostgresIcon from '@/assets/icons/postgres.astro';
import NodeIcon from '@/assets/icons/node.astro';


const techs = [
  { name: 'React',      icon: ReactIcon },
  { name: 'Next.js',    icon: NextIcon },
  { name: 'TypeScript', icon: TypescriptIcon },
  { name: 'Astro',      icon: AstroaIcon },
  { name: 'Tailwind',   icon: TailwindIcon },
  { name: 'Node.js',    icon: NodeIcon },
  { name: 'FastAPI',    icon: FastapiIcon },
  { name: 'Laravel',    icon: LaravelIcon },
  { name: 'MySQL',      icon: MysqlIcon },
  { name: 'Postgres',   icon: PostgresIcon },
  { name: 'Supabase',   icon: SupabaseIcon },
];

/* Dos filas que derivan en sentidos opuestos leen como una superficie en
   movimiento, no como un ticker. Ambas llevan la lista completa — la segunda
   rotada — para que cada mitad de cada track supere cualquier viewport y el
   loop del -50% nunca enseñe un borde. */
const offset = Math.ceil(techs.length / 2);
const rows = [techs, [...techs.slice(offset), ...techs.slice(0, offset)]];
---

<section class="section overflow-hidden">
  <SectionHeader
    eyebrow="Stack"
    title="Tecnologías que usamos"
  />

  <div class="marquee-mask relative flex flex-col gap-4" data-reveal>
    {rows.map((row, ri) => (
      <div
        class="marquee-track flex gap-4"
        data-marquee
        data-marquee-duration={ri === 1 ? '34' : '28'}
        data-marquee-reverse={ri === 1 ? '' : undefined}
      >
        {/* duplicado para un loop sin costura */}
        {[...row, ...row].map((t) => (
          <div class="group flex shrink-0 cursor-default items-center gap-3 rounded-[12px] border border-white/[0.07] bg-[#0d0d10] px-5 py-3 text-[#b3b3ba] transition-colors duration-300 hover:border-white/15 hover:text-white">
            <t.icon class="size-8 shrink-0 opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
            <span class="text-[15px] font-normal whitespace-nowrap">{t.name}</span>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .marquee-track {
    width: max-content;
  }
</style>
