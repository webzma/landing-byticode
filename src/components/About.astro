---
import SectionHeader from './SectionHeader.astro';

const stats = [
  { value: '32+', label: 'Proyectos completados' },
  { value: '3+',  label: 'Años de experiencia' },
  { value: '100%', label: 'Clientes satisfechos' },
];
---

<section id="about" class="section">
  <SectionHeader
    eyebrow="Nosotros"
    title="Sobre Byticode"
    description="Somos un estudio de diseño y desarrollo que combina creatividad con tecnología. Creemos en soluciones minimales que escalan: identidades que perduran, productos que funcionan y experiencias que conectan."
    titleWidth="20ch"
  />

  <p
    class="mx-auto mt-5 mb-0 max-w-[56ch] text-center text-[17px] font-light leading-[1.75] text-[#9a9aa1]"
    data-reveal>
    Trabajamos con startups y empresas que buscan dar el salto digital sin perder su esencia.
    Cada proyecto es único, y por eso adaptamos nuestro proceso a ti.
  </p>

  <!-- Los números caen como su propia fila, con el mismo peso visual -->
  <div class="mt-16 grid grid-cols-3 gap-5 max-[640px]:mt-10 max-[640px]:gap-3">
    {stats.map((s, i) => (
      <div
        class="card px-8 py-9 text-center max-[580px]:px-3 max-[580px]:py-6"
        data-reveal
        data-spotlight
        style={`--rd:${i * 60}ms`}
      >
        <div class="card-glow-blob" style="top:-45%;left:50%;transform:translateX(-50%);width:80%;height:100%;background:radial-gradient(circle, rgba(47,107,255,0.35), transparent 64%);" aria-hidden="true"></div>
        <div class="relative">
          <div class="mb-2 text-[42px] font-light leading-none tracking-[-0.02em] text-[#f1f1f4] tabular-nums max-[580px]:text-[1.75rem]">{s.value}</div>
          <div class="text-[13px] font-light leading-[1.4] text-[#8b8b92] max-[580px]:text-[0.7rem]">{s.label}</div>
        </div>
      </div>
    ))}
  </div>
</section>
