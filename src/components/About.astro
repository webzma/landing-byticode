---
import SectionHeader from './SectionHeader.astro';

const stats = [
  { value: '32+', label: 'Proyectos completados' },
  { value: '3+',  label: 'Años de experiencia' },
  { value: '100%', label: 'Clientes satisfechos' },
];
---

<section id="about" class="bg-background py-28 px-6 max-[900px]:py-20 max-[640px]:py-16 max-[640px]:px-5">
  <div class="max-w-[1080px] mx-auto">

    <SectionHeader
      eyebrow="Nosotros"
      title="Sobre Byticode"
      description="Somos un estudio de diseño y desarrollo que combina creatividad con tecnología. Creemos en soluciones minimales que escalan: identidades que perduran, productos que funcionan y experiencias que conectan."
      titleWidth="20ch"
    />

    <p
      class="mx-auto mt-5 mb-0 max-w-[56ch] text-center text-[clamp(0.9375rem,1.3vw,1.0625rem)] leading-[1.75] text-white/60"
      data-reveal
      data-reveal-delay="3">
      Trabajamos con startups y empresas que buscan dar el salto digital sin perder su esencia.
      Cada proyecto es único, y por eso adaptamos nuestro proceso a ti.
    </p>

    <!-- The numbers land as their own row, evenly weighted -->
    <div class="mt-16 grid grid-cols-3 gap-5 max-[640px]:mt-10 max-[640px]:gap-3">
      {stats.map((s, i) => (
        <div
          class="rounded-[14px] border border-white/[0.1] bg-white/[0.04] px-8 py-8 text-center transition-[border-color,background-color] duration-500 ease-soft hover:border-white/20 hover:bg-white/[0.06] max-[580px]:px-3 max-[580px]:py-6"
          data-reveal
          style={`--rd:${i * 90}ms`}
        >
          <div class="mb-2 text-[2.5rem] font-extrabold leading-none tracking-[-0.04em] text-white tabular-nums max-[580px]:text-[1.75rem]">{s.value}</div>
          <div class="text-[0.8125rem] leading-[1.4] text-white/40 max-[580px]:text-[0.7rem]">{s.label}</div>
        </div>
      ))}
    </div>

  </div>
</section>
