---
import SectionHeader from './SectionHeader.astro';

/* Iconos a tamaño grande sobre el glow azul — el patrón de la referencia */
const steps = [
  {
    title: 'Descubrimiento',
    description: 'Entendemos tu negocio, objetivos y audiencia para definir la estrategia correcta.',
    icon: `<svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
  },
  {
    title: 'Diseño',
    description: 'Creamos wireframes y prototipos que validan la experiencia antes de construir.',
    icon: `<svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>`,
  },
  {
    title: 'Desarrollo',
    description: 'Codificamos con tecnologías modernas, rendimiento óptimo y buenas prácticas.',
    icon: `<svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  },
  {
    title: 'Lanzamiento',
    description: 'Desplegamos, optimizamos el rendimiento y te acompañamos en el crecimiento.',
    icon: `<svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>`,
  },
];
---

<section id="process" class="section">
  <SectionHeader
    eyebrow="Proceso"
    title="Cómo trabajamos"
    description="Un proceso transparente e iterativo para que estés involucrado en cada etapa."
  />

  <ol class="m-0 grid list-none grid-cols-4 gap-5 p-0 max-[1100px]:grid-cols-2 max-[640px]:grid-cols-1">
    {steps.map((step, i) => (
      <li
        class="card process-card"
        data-reveal
        data-spotlight
        style={`--rd:${i * 60}ms`}
      >
        <div class="process-visual" aria-hidden="true">
          <Fragment set:html={step.icon} />
        </div>
        <div class="px-6 pt-2 pb-7">
          <h3 class="m-0 mb-2.5 text-[18px] font-medium text-[#f1f1f4]">{step.title}</h3>
          <p class="m-0 text-[14.5px] font-light leading-[1.6] text-[#9a9aa1]">{step.description}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .process-card {
    background: var(--surface-3);
    border-radius: 20px;
  }
  .process-visual {
    position: relative;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-ink);
    background: radial-gradient(
      ellipse 80% 100% at 50% 0%,
      rgba(47, 107, 255, 0.32),
      rgba(106, 59, 255, 0.12) 50%,
      transparent 78%
    );
  }
  .process-visual :global(svg) {
    filter: drop-shadow(0 0 14px rgba(60, 110, 255, 0.85))
      drop-shadow(0 6px 18px rgba(60, 110, 255, 0.5));
  }
</style>
