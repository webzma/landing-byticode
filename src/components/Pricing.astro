---
import SectionHeader from './SectionHeader.astro';

const plans = [
  {
    name: 'Esencial',
    price: '$499',
    period: 'USD / proyecto',
    description: 'Ideal para emprendedores y pequeños negocios que necesitan presencia digital rápida y profesional.',
    features: [
      'Landing page o sitio vitrina',
      'Diseño UI/UX personalizado',
      'Responsive para todos los dispositivos',
      'SEO básico on-page',
      'Formulario de contacto',
      '1 ronda de revisiones',
      'Entrega en ~2 semanas',
    ],
    cta: 'Empezar proyecto',
    featured: false,
  },
  {
    name: 'Pro',
    price: '$1,499',
    period: 'USD / proyecto',
    description: 'Para negocios que quieren una solución completa: diseño avanzado, backend robusto e integraciones.',
    features: [
      'Sitio web completo o app web',
      'Diseño UI/UX avanzado',
      'Backend + base de datos',
      'Integraciones (APIs, CRM, pagos)',
      'SEO técnico + rendimiento',
      '3 rondas de revisiones',
      '1 mes de soporte post-lanzamiento',
    ],
    cta: 'Empezar proyecto',
    featured: true,
  },
  {
    name: 'A medida',
    price: 'Custom',
    period: 'hablemos primero',
    description: 'Para proyectos ambiciosos: plataformas SaaS, apps móviles, sistemas complejos o consultoría estratégica.',
    features: [
      'Arquitectura y tecnología a medida',
      'Plataformas SaaS o apps móviles',
      'Equipo dedicado y escalable',
      'Consultoría técnica y estratégica',
      'Revisiones ilimitadas',
      'Soporte y mantenimiento continuo',
      'Roadmap y acompañamiento completo',
    ],
    cta: 'Conversemos',
    featured: false,
  },
];
---

<section id="pricing" class="section section--narrow">
  <SectionHeader
    eyebrow="Planes"
    title="Inversión clara, resultados reales"
    description="Sin costos ocultos ni sorpresas. Elige el plan que mejor se adapta a tu etapa y objetivos."
  />

  <div class="grid grid-cols-3 items-stretch gap-5 max-[1100px]:grid-cols-2 max-[640px]:grid-cols-1">
    {plans.map((plan, i) => (
      <article
        class:list={[
          "card flex flex-col p-8",
          plan.featured && "card--featured",
        ]}
        data-reveal
        data-spotlight
        style={`--rd:${i * 60}ms`}
      >
        {plan.featured && (
          <div
            class="card-glow-blob"
            style="top:-30%;right:-20%;width:80%;height:90%;background:radial-gradient(circle, rgba(47,107,255,0.5), transparent 64%);filter:blur(40px);"
            aria-hidden="true"
          ></div>
        )}

        <div class="relative flex flex-1 flex-col">
          <div class="mb-1 flex items-center justify-between gap-3">
            <h3 class="m-0 text-[20px] font-medium text-[#f1f1f4]">{plan.name}</h3>
            {plan.featured && (
              <span class="shrink-0 rounded-full bg-[#2f6bff] px-3 py-[5px] text-[11.5px] font-normal text-white">
                Más elegido
              </span>
            )}
          </div>
          <p class:list={[
            "m-0 mb-6 text-[14px] font-light",
            plan.featured ? "text-[#b7bdd0]" : "text-[#8b8b92]",
          ]}>{plan.description}</p>

          <div class="flex items-baseline gap-2">
            <span class:list={[
              "text-[42px] font-normal leading-none",
              plan.featured ? "text-white" : "text-[#f1f1f4]",
            ]}>{plan.price}</span>
            <span class:list={[
              "text-[14px] font-light",
              plan.featured ? "text-[#b7bdd0]" : "text-[#8b8b92]",
            ]}>{plan.period}</span>
          </div>

          <a
            href="#contact"
            class:list={[
              "mt-6 mb-7 block rounded-[12px] py-[13px] text-center text-[14.5px] font-medium no-underline transition-colors duration-200",
              plan.featured
                ? "bg-[#2f6bff] text-white shadow-[0_14px_30px_-12px_rgba(47,107,255,0.9)] hover:bg-[#3f78ff]"
                : "border border-white/[0.14] bg-white/[0.06] text-[#ededf0] hover:bg-white/[0.1]",
            ]}
          >
            {plan.cta}
          </a>

          <ul class="m-0 flex flex-1 list-none flex-col gap-[14px] p-0">
            {plan.features.map((feature) => (
              <li class:list={[
                "flex items-center gap-[11px] text-[14.5px] font-light",
                plan.featured ? "text-[#e3e6ee]" : "text-[#c4c4cc]",
              ]}>
                <span class="text-[#8ab0ff]" aria-hidden="true">&#10003;</span>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>

  <p class="m-0 mt-10 text-center text-[13px] font-light text-[#6f6f77]" data-reveal="soft">
    Todos los proyectos incluyen código limpio, documentación y transferencia completa de activos.
    <a href="#contact" class="ml-1 text-[#b3b3ba] underline underline-offset-2 transition-colors duration-200 hover:text-white">¿Dudas? Hablemos.</a>
  </p>
</section>

<style>
  /* El plan destacado hereda el tratamiento azul de la referencia */
  .card--featured {
    background: linear-gradient(180deg, rgba(30, 40, 90, 0.55), #0d0d10 60%);
    border-color: rgba(90, 120, 255, 0.45);
  }
</style>
