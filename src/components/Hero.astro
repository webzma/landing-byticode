---
import wilberkImage from "../assets/members/wilberk.jpeg";
import juanImage from "../assets/members/juan.jpg";
import emmanuelImage from "../assets/members/emmanuel.jpeg";
import danielImage from "../assets/members/daniel.jpeg";

/* Prueba social del hero: las caras reales del equipo, no placeholders */
const avatars = [wilberkImage, juanImage, emmanuelImage, danielImage];
---

<div class="relative overflow-hidden">
  <!-- Cielo estrellado + aurora + grano (el canvas lo anima motion.ts) -->
  <div data-bg aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="aurora aurora-a"></div>
    <div class="aurora aurora-b"></div>
    <canvas data-sky class="absolute inset-0 block h-full w-full"></canvas>
    <div class="hero-bloom"></div>
    <div class="hero-horizon"></div>
    <div class="hero-noise"></div>
  </div>

  <section id="hero" class="hero-inner">
    <!-- prueba social -->
    <div class="hero-proof">
      <div class="hero-avatars">
        {avatars.map((a) => <img src={a.src} alt="" class="hero-avatar" loading="eager" />)}
      </div>
      <div class="hero-proof-text">
        <div class="hero-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <div class="hero-proof-line">+32 proyectos entregados</div>
      </div>
    </div>

    <h1 class="hero-title">
      Diseñamos y desarrollamos<br />software a medida.
    </h1>

    <p class="hero-sub">
      Creamos sitios web rápidos y herramientas internas para que gestiones tu negocio y optimices tus procesos.
    </p>

    <div class="hero-cta">
      <a href="#contact" class="btn-primary">
        Reservar llamada <span class="text-[16px]" aria-hidden="true">&#8594;</span>
      </a>
      <a href="#work" class="btn-ghost">Ver proyectos</a>
    </div>
  </section>
</div>

<style>
  /* ── Capas de fondo: tal cual la referencia ─────────────────────── */
  .aurora {
    position: absolute;
    pointer-events: none;
  }
  .aurora-a {
    top: 5%;
    left: 9%;
    width: 460px;
    max-width: 50vw;
    height: 360px;
    background: radial-gradient(circle, rgba(106, 59, 255, 0.13), transparent 70%);
    filter: blur(46px);
  }
  .aurora-b {
    top: 11%;
    right: 7%;
    width: 420px;
    max-width: 46vw;
    height: 330px;
    background: radial-gradient(circle, rgba(31, 170, 201, 0.11), transparent 70%);
    filter: blur(48px);
  }
  .hero-bloom {
    position: absolute;
    bottom: -30px;
    left: 50%;
    width: 1280px;
    max-width: 138vw;
    height: 560px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse 52% 62% at 50% 60%,
      rgba(47, 107, 255, 0.44),
      rgba(106, 59, 255, 0.24) 32%,
      rgba(31, 170, 201, 0.13) 52%,
      transparent 74%
    );
    filter: blur(42px);
    mask-image: linear-gradient(to bottom, #000 60%, transparent 94%);
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 94%);
    animation: byti-drift 16s ease-in-out infinite;
  }
  .hero-horizon {
    position: absolute;
    bottom: 118px;
    left: 50%;
    width: 70%;
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(
      90deg,
      transparent,
      rgba(170, 195, 255, 0.5) 42%,
      rgba(190, 210, 255, 0.62) 50%,
      rgba(170, 195, 255, 0.5) 58%,
      transparent
    );
    mask-image: linear-gradient(to bottom, transparent, #000);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000);
  }
  .hero-noise {
    position: absolute;
    inset: 0;
    opacity: 0.32;
    mix-blend-mode: overlay;
    background-image: var(--grain);
  }

  /* ── Contenido ──────────────────────────────────────────────────── */
  .hero-inner {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    min-height: 94vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 110px 24px 140px;
  }
  .hero-proof {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    margin: 0 auto 44px;
  }
  .hero-avatars {
    display: flex;
  }
  .hero-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid var(--bg);
    object-fit: cover;
    margin-right: -10px;
  }
  .hero-avatar:last-child {
    margin-right: 0;
  }
  .hero-proof-text {
    text-align: left;
  }
  .hero-stars {
    color: var(--star);
    font-size: 13px;
    letter-spacing: 1px;
    line-height: 1;
  }
  .hero-proof-line {
    color: var(--muted);
    font-size: 14px;
    margin-top: 5px;
  }
  .hero-title {
    font-weight: 300;
    font-size: clamp(40px, 6.4vw, 86px);
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin: 0 0 26px;
    color: var(--text-strong);
    text-wrap: balance;
  }
  .hero-sub {
    font-weight: 300;
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.6;
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto 40px;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding: 88px 20px 110px;
    }
    .hero-proof {
      margin-bottom: 32px;
    }
    .hero-title {
      font-size: clamp(34px, 9.5vw, 44px);
    }
    .hero-cta :global(.btn-primary),
    .hero-cta :global(.btn-ghost) {
      width: 100%;
    }
  }
</style>
