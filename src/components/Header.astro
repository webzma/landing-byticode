---
import ImgLogo from "@/assets/logo-byticode-without-bg-po.webp";

const navLinks = [
  { label: "Proceso", href: "#process" },
  { label: "Proyectos", href: "#work" },
  { label: "Servicios", href: "#services" },
  { label: "Nosotros", href: "#about" },
  { label: "FAQs", href: "#faqs" },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-20 backdrop-blur-[10px]">
  <div
    class="mx-auto flex max-w-[1080px] items-center justify-between gap-6 px-6 py-4 max-lg:px-5">

    <!-- Logo + nav travel together on the left, CTA anchors the right -->
    <div class="flex items-center gap-10">
      <a
        href="/"
        class="flex text-[1.4rem] font-bold text-white no-underline tracking-[-0.02em] transition-opacity duration-200 ease-soft hover:opacity-75"
        aria-label="Byticode Home">
        <img src={ImgLogo.src} alt="Byticode Logo" class="w-8 h-8 invert mr-2" />
        Byticode
      </a>

      <!-- Desktop nav -->
      <nav class="max-lg:hidden" aria-label="Main navigation">
        <ul class="flex items-center gap-7 list-none m-0 p-0">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[0.9375rem] text-white/70 no-underline transition-colors duration-200 ease-soft hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Desktop CTA -->
    <a
      href="#contact"
      class="inline-flex items-center text-sm font-medium no-underline rounded overflow-hidden transition-opacity duration-200 ease-soft hover:opacity-90 max-lg:hidden">
      <span class="block px-4 py-2 bg-white text-black">Reservar llamada</span>
      <span
        class="flex items-center justify-center w-[2.125rem] py-2 bg-accent text-white self-stretch">
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          aria-hidden="true">
          <path
            d="M2 7h10M8 3l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>

    <!-- Hamburger button (mobile only) -->
    <button
      id="menu-toggle"
      class="hidden max-lg:flex flex-col gap-[5px] items-center justify-center w-9 h-9 text-white shrink-0"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu">
      <span
        id="ham-line-1"
        class="block w-[20px] h-px bg-current transition-all duration-200 ease-soft origin-center"
      ></span>
      <span
        id="ham-line-2"
        class="block w-[20px] h-px bg-current transition-all duration-200 ease-soft"></span>
      <span
        id="ham-line-3"
        class="block w-[20px] h-px bg-current transition-all duration-200 ease-soft origin-center"
      ></span>
    </button>
  </div>
</header>

<!-- Mobile menu overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-100 flex flex-col px-5 pt-5 pb-8 bg-black/97 backdrop-blur-xl translate-x-full transition-transform duration-500 ease-soft lg:hidden!"
  aria-label="Menú de navegación móvil">
  <!-- Top bar -->
  <div class="flex items-center justify-between mb-10">
    <a
      href="/"
      class="text-[1.4rem] font-bold text-white no-underline tracking-[-0.02em] flex"
      aria-label="Byticode Home">
      <img src={ImgLogo.src} alt="Byticode Logo" class="w-8 h-8 invert mr-2" />
      Byticode
 </a>
    <button
      id="menu-close"
      class="w-9 h-9 flex items-center justify-center text-white/55 hover:text-white transition-colors duration-150"
      aria-label="Cerrar menú">
      <svg
        width="18"
        height="18"
        viewBox="0 0 18 18"
        fill="none"
        aria-hidden="true">
        <path
          d="M2 2l14 14M16 2L2 16"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!-- Nav links -->
  <nav class="flex-1" aria-label="Navegación móvil">
    <ul class="flex flex-col list-none m-0 p-0">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-nav-link flex items-center justify-between py-4.5 text-[1.375rem] font-semibold text-white/65 hover:text-white border-b border-white/[0.07] transition-colors duration-150 no-underline tracking-[-0.02em]">
              {link.label}
              <svg
                width="13"
                height="13"
                viewBox="0 0 15 15"
                fill="none"
                aria-hidden="true"
                class="opacity-25 shrink-0">
                <path
                  d="M2.5 7.5h10M8.5 3.5l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Mobile CTA -->
  <div class="mt-8">
    <a
      href="#contact"
      class="mobile-nav-link flex items-center justify-center gap-2 py-3.5 px-6 bg-white text-black no-underline text-[0.9375rem] font-semibold rounded w-full transition-opacity duration-200 hover:opacity-90">
      Reservar llamada
      <svg
        width="14"
        height="14"
        viewBox="0 0 15 15"
        fill="none"
        aria-hidden="true">
        <path
          d="M2.5 7.5h10M8.5 3.5l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const closeBtn = document.getElementById("menu-close");
  const menu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  function openMenu() {
    menu?.classList.remove("translate-x-full");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu?.classList.add("translate-x-full");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  mobileLinks.forEach((link) => link.addEventListener("click", closeMenu));

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  // Solidify the header once the page is scrolled
  const header = document.getElementById("site-header");
  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 24);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
