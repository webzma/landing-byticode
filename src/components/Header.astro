---
import ImgLogo from "@/assets/logo-byticode-without-bg-po.webp";

const navLinks = [
  { label: "Servicios", href: "#services" },
  { label: "Proyectos", href: "#work" },
  { label: "Proceso", href: "#process" },
  { label: "Nosotros", href: "#about" },
  { label: "FAQs", href: "#faqs" },
];
---

<header id="site-header">
  <div
    class="mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-10 py-5 max-lg:px-6 max-[640px]:px-5">

    <!-- Wordmark -->
    <a
      href="/"
      class="flex items-center gap-[11px] text-[19px] font-medium tracking-[-0.01em] text-white no-underline"
      aria-label="Byticode Home">
      <img src={ImgLogo.src} alt="" class="h-[26px] w-[26px] object-contain invert" />
      byticode
    </a>

    <!-- Desktop nav -->
    <nav class="flex items-center gap-[34px] max-lg:hidden" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-[14.5px] text-[#b3b3ba] no-underline transition-colors duration-200 hover:text-white">
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop CTA -->
    <a
      href="#contact"
      class="inline-flex items-center gap-2 rounded-[10px] border border-white/60 bg-[#ededf0] px-[18px] py-[10px] text-[14px] font-medium text-[#0a0a0c] no-underline transition-colors duration-200 hover:bg-white max-lg:hidden">
      Agendar llamada <span class="text-[15px]" aria-hidden="true">&#8594;</span>
    </a>

    <!-- Hamburger button (mobile only) -->
    <button
      id="menu-toggle"
      class="hidden max-lg:flex flex-col gap-[5px] items-center justify-center w-9 h-9 text-white shrink-0 cursor-pointer"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu">
      <span class="block w-[20px] h-px bg-current"></span>
      <span class="block w-[20px] h-px bg-current"></span>
      <span class="block w-[20px] h-px bg-current"></span>
    </button>
  </div>
</header>

<!-- Mobile menu overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-100 flex flex-col px-5 pt-5 pb-8 bg-[#08080a]/97 backdrop-blur-xl translate-x-full transition-transform duration-500 ease-soft lg:hidden!"
  aria-label="Menú de navegación móvil">
  <!-- Top bar -->
  <div class="flex items-center justify-between mb-10">
    <a
      href="/"
      class="flex items-center gap-[11px] text-[19px] font-medium text-white no-underline"
      aria-label="Byticode Home">
      <img src={ImgLogo.src} alt="" class="h-[26px] w-[26px] object-contain invert" />
      byticode
    </a>
    <button
      id="menu-close"
      class="w-9 h-9 flex items-center justify-center text-white/55 hover:text-white transition-colors duration-150 cursor-pointer"
      aria-label="Cerrar menú">
      <svg
        width="18"
        height="18"
        viewBox="0 0 18 18"
        fill="none"
        aria-hidden="true">
        <path
          d="M2 2l14 14M16 2L2 16"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!-- Nav links -->
  <nav class="flex-1" aria-label="Navegación móvil">
    <ul class="flex flex-col list-none m-0 p-0">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-nav-link flex items-center justify-between py-4.5 text-[1.375rem] font-light text-white/70 hover:text-white border-b border-white/[0.07] transition-colors duration-150 no-underline tracking-[-0.01em]">
              {link.label}
              <svg
                width="13"
                height="13"
                viewBox="0 0 15 15"
                fill="none"
                aria-hidden="true"
                class="opacity-25 shrink-0">
                <path
                  d="M2.5 7.5h10M8.5 3.5l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Mobile CTA -->
  <div class="mt-8">
    <a
      href="#contact"
      class="mobile-nav-link btn-primary w-full">
      Agendar llamada
      <span aria-hidden="true">&#8594;</span>
    </a>
  </div>
</div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const closeBtn = document.getElementById("menu-close");
  const menu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  function openMenu() {
    menu?.classList.remove("translate-x-full");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu?.classList.add("translate-x-full");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  mobileLinks.forEach((link) => link.addEventListener("click", closeMenu));

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  // The header condenses once the page is scrolled (reference behavior)
  const header = document.getElementById("site-header");
  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 24);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
