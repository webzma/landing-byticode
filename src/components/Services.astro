---
import SectionHeader from './SectionHeader.astro';

/* Glow de esquina por tarjeta — las mismas posiciones que la referencia */
const services = [
  {
    title: 'Web & Apps',
    description: 'Sitios web rápidos, apps móviles y experiencias digitales que convierten.',
    detail: 'UI/UX · Desarrollo · Optimización',
    glow: 'top:-40%;left:-20%;width:70%;height:90%;background:radial-gradient(circle, rgba(47,107,255,0.5), transparent 65%);',
  },
  {
    title: 'Branding & Design',
    description: 'Identidad visual, logos minimales y diseño que transmite tu esencia de marca.',
    detail: 'Logotipo · Sistema de diseño · Guía de marca',
    glow: 'top:-45%;right:-25%;width:80%;height:100%;background:radial-gradient(circle, rgba(70,90,255,0.45), transparent 64%);',
  },
  {
    title: 'Consultoría',
    description: 'Estrategia técnica y roadmap para escalar tu producto digital al siguiente nivel.',
    detail: 'Auditoría · Estrategia · Roadmap',
    glow: 'top:-50%;right:-30%;width:95%;height:120%;background:radial-gradient(circle, rgba(47,107,255,0.6), rgba(106,59,255,0.25) 45%, transparent 66%);',
  },
];
---

<section id="services" class="section section--first">
  <SectionHeader
    eyebrow="Servicios"
    title="Lo que hacemos"
    description="Creamos soluciones digitales a medida para empresas que quieren destacar en el mundo digital."
  />

  <div class="grid grid-cols-3 gap-5 max-[900px]:grid-cols-1">
    {services.map((s, i) => (
      <article
        class="card p-[30px] min-h-[158px]"
        data-reveal
        data-spotlight
        style={`--rd:${i * 60}ms`}
      >
        <div class="card-glow-blob" style={s.glow} aria-hidden="true"></div>
        <div class="relative">
          <h3 class="m-0 mb-3 text-[19px] font-medium text-[#f1f1f4]">{s.title}</h3>
          <p class="m-0 text-[14.5px] font-light leading-[1.6] text-[#9a9aa1]">{s.description}</p>
          <p class="m-0 mt-5 text-[13px] font-light text-[#6f6f77]">{s.detail}</p>
        </div>
      </article>
    ))}
  </div>
</section>
